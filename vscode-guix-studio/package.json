{
  "name": "vscode-guix-studio",
  "displayName": "GUIX Studio (Preview)",
  "description": "Preview VS Code extension scaffolding for GUIX Studio (.gxp) projects.",
  "version": "0.0.1",
  "publisher": "eclipse-threadx",
  "engines": {
    "vscode": "^1.85.0"
  },
  "activationEvents": [
    "onLanguage:guix-gxp",
    "workspaceContains:**/*.gxp",
    "onCommand:guix.openDesigner",
    "onCommand:guix.openProject",
    "onCommand:guix.projectSummary",
    "onCommand:guix.validateProject",
    "onCommand:guix.generateOutputs",
    "onCommand:guix.quickGenerateOutputs",
    "onCommand:guix.migrateProject",
    "onCommand:guix.refreshProjects",
    "onCommand:guix.selectCliPath",
    "onCommand:guix.addVsCodeTasks",
    "onCommand:guix.buildCli"
  ],
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "guix.openDesigner",
        "title": "GUIX: Open Designer (Preview)"
      },
      {
        "command": "guix.openProject",
        "title": "GUIX: Open Project (.gxp)"
      },
      {
        "command": "guix.migrateProject",
        "title": "GUIX: Migrate Project (.gxp)"
      },
      {
        "command": "guix.projectSummary",
        "title": "GUIX: Project Summary"
      },
      {
        "command": "guix.generateOutputs",
        "title": "GUIX: Generate Outputs"
      },
      {
        "command": "guix.quickGenerateOutputs",
        "title": "GUIX: Quick Generate (Active .gxp)"
      },
      {
        "command": "guix.validateProject",
        "title": "GUIX: Validate Project"
      },
      {
        "command": "guix.refreshProjects",
        "title": "GUIX: Refresh Projects"
      },
      {
        "command": "guix.selectCliPath",
        "title": "GUIX: Select CLI Path"
      },
      {
        "command": "guix.addVsCodeTasks",
        "title": "GUIX: Add VS Code Tasks"
      },
      {
        "command": "guix.buildCli",
        "title": "GUIX: Build CLI (CMake)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "guixStudio",
          "title": "GUIX",
          "icon": "resources/guix.svg"
        }
      ]
    },
    "views": {
      "guixStudio": [
        {
          "id": "guixProjects",
          "name": "Projects",
          "icon": "resources/guix.svg"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "guix.refreshProjects",
          "when": "view == guixProjects",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "guix.projectSummary",
          "when": "view == guixProjects && viewItem == guixGxp",
          "group": "inline"
        },
        {
          "command": "guix.migrateProject",
          "when": "view == guixProjects && viewItem == guixGxp",
          "group": "inline"
        },
        {
          "command": "guix.validateProject",
          "when": "view == guixProjects && viewItem == guixGxp",
          "group": "inline"
        },
        {
          "command": "guix.generateOutputs",
          "when": "view == guixProjects && viewItem == guixGxp",
          "group": "inline"
        }
      ]
    },
    "languages": [
      {
        "id": "guix-gxp",
        "aliases": [
          "GUIX Studio Project"
        ],
        "extensions": [
          ".gxp"
        ]
      }
    ],
    "customEditors": [
      {
        "viewType": "guixStudio.gxpDesigner",
        "displayName": "GUIX Designer (Preview)",
        "selector": [
          {
            "filenamePattern": "*.gxp"
          }
        ],
        "priority": "option"
      }
    ],
    "configuration": {
      "title": "GUIX Studio",
      "properties": {
        "guixStudio.cli.path": {
          "type": "string",
          "default": "",
          "description": "Path to the guix_studio_cli executable. If empty, the extension will auto-detect via env var (GUIX_STUDIO_CLI_PATH), common build locations, and PATH."
        },
        "guixStudio.outputPath": {
          "type": "string",
          "default": "",
          "description": "Default output directory for GUIX generation. If empty, the extension will prompt. If relative, it is resolved against the first workspace folder."
        },
        "guixStudio.generateOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Automatically run Quick Generate when a .gxp file is saved. Requires guixStudio.outputPath or generation will be skipped."
        },
        "guixStudio.validateOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Run GUIX project validation when a .gxp file is saved."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "smoke:gxp": "npm run -s compile && node scripts/smoke-theme-resources.js",
    "watch": "tsc -watch -p ./",
    "lint": "node -e \"console.log('lint not configured yet')\""
  },
  "dependencies": {
    "fast-xml-parser": "^5.3.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.3"
  }
}
